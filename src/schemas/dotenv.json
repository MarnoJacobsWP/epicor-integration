{
  "type": "object",
  "$id": "schema:config:env",
  "required": [
    "NODE_ENV",
    "BASE_URL",
    "API_USERNAME",
    "API_PASSWORD",
    "API_KEY",
    "HUBSPOT_ACCESS_TOKEN",
    "MONGO_URI"
  ],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "default": "development"
    },
    "PORT": {
      "type": "integer",
      "default": 3000
    },
    "HOST": {
      "type": "string",
      "default": "0.0.0.0"
    },
    "BASE_URL": {
      "type": "string"
    },
    "API_USERNAME": {
      "type": "string"
    },
    "API_PASSWORD": {
      "type": "string"
    },
    "API_KEY": {
      "type": "string"
    },
    "HUBSPOT_ACCESS_TOKEN": {
      "type": "string"
    },
    "MONGO_URI": {
      "type": "string"
    },
    "LOG_LEVEL": {
      "type": "string",
      "default": "info"
    },
    "MAX_REQUEST_TIMEOUT": {
      "type": "integer",
      "default": 60000
    },
    "BODY_LIMIT": {
      "type": "integer",
      "default": 1048576
    },
    "RATE_LIMIT_MAX": {
      "type": "integer",
      "default": 100
    },
    "RATE_LIMIT_WINDOW": {
      "type": "integer",
      "default": 60000
    },
    "ALLOW_INSECURE_TLS": {
      "type": "boolean",
      "default": false
    },
    "FILTER_TIMESTAMP": {
      "type": "integer"
    },
    "HUBSPOT_PIPELINE_QUOTES": {
      "type": "string",
      "default": "default"
    },
    "HUBSPOT_DEAL_STAGE_QUOTE_CREATED": {
      "type": "string",
      "default": "2817003207"
    },
    "HUBSPOT_DEAL_STAGE_CLOSED_WON": {
      "type": "string",
      "default": "closedwon"
    },
    "HUBSPOT_ASSOCIATION_COMPANY_TO_CONTACT": {
      "type": "integer",
      "default": 2
    },
    "HUBSPOT_ASSOCIATION_DEAL_TO_COMPANY": {
      "type": "integer",
      "default": 5
    },
    "HUBSPOT_ASSOCIATION_LINE_ITEM_TO_DEAL": {
      "type": "integer",
      "default": 20
    }
  }
}